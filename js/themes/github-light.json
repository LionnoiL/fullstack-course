{
  "id": "github-light",
  "name": "GitHub Light",
  "type": "light",
  "preview": ["#ffffff", "#0969da", "#8250df", "#1a7f37"],
  "vars": {
    "--bg": "#ffffff",
    "--panel": "#f6f8fa",
    "--line": "#d0d7de",
    "--text": "#1f2328",
    "--muted": "#57606a",
    "--soft": "#f6f8fa",
    "--accent": "#0969da",
    "--surface": "#f6f8fa",
    "--border": "#d0d7de",
    "--text-primary": "#1f2328",
    "--text-muted": "#57606a",
    "--code-bg": "#f6f8fa",
    "--code-inline-bg": "#eff1f3",
    "--code-inline-color": "#953800",
    "--token-comment": "#6e7781",
    "--token-punctuation": "#24292f",
    "--token-operator": "#24292f",
    "--token-keyword": "#cf222e",
    "--token-string": "#0a7d33",
    "--token-number": "#0550ae",
    "--token-function": "#8250df",
    "--token-class": "#953800",
    "--token-property": "#0550ae",
    "--token-deleted": "#cf222e",
    "--color-done": "#1a7f37",
    "--color-done-text": "#ffffff",
    "--color-fail": "#cf222e",
    "--color-warn": "#9a6700",
    "--avatar-text": "#ffffff",
    "--alert-info-border": "#0969da",
    "--alert-info-bg": "rgba(9, 105, 218, 0.06)",
    "--alert-danger-border": "#cf222e",
    "--alert-danger-bg": "rgba(207, 34, 46, 0.06)",
    "--alert-warn-border": "#9a6700",
    "--alert-warn-bg": "rgba(154, 103, 0, 0.06)",
    "--mark-bg": "rgba(154, 103, 0, 0.15)",
    "--mark-color": "#7a5300",
    "--mark-hover-bg": "rgba(207, 34, 46, 0.1)",
    "--mark-hover-color": "#cf222e"
  }
}
